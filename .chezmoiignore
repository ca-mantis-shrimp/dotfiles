{{ if ne .chezmoi.os "android" }}
# The phone (Termux): its boot script, and the keys allowed to ssh into it.
.termux/
.ssh/authorized_keys
{{ else }}
# The phone takes an allowlist: shell, git, nvim and agent config, enough to work
# offline. Desktop, systemd and linux/amd64 config stays off it by default.
# Products/platform (.chezmoiexternal.toml) still applies, for the clearhead skill links.
*
!.bashrc
!.gitconfig
!.markdownlint-cli2.yaml
!.claude
!.pi
# pi rewrites this file, as on agent hosts.
.pi/agent/settings.json
!.gemini
!.termux
!.ssh
!.config
.config/*
!.config/fish
!.config/starship.toml
!.config/nvim
!.config/mcphub
!.config/clearhead
!.local
.local/*
!.local/bin
.local/bin/*
!.local/bin/chezmoi-diff
!.local/bin/chezmoi-pager
!.local/bin/nv
!.local/bin/nvc
{{ end }}

{{ if ne .chezmoi.hostname "mini-travel-server" }}
# Radicale CalDAV sync: needs local Radicale and a TPM-sealed credential
.vdirsyncer/
.config/systemd/user/vdirsyncer.service
.config/systemd/user/vdirsyncer.timer
.config/systemd/user/timers.target.wants/vdirsyncer.timer
{{ end }}

{{ if eq (index . "role" | default "desktop") "agent-host" }}
# Agent hosts (headless, immutable image) take an allowlist: shell, git, editor
# and agent config. New desktop config stays off them by default. Units on the
# host are its own (shpool, srr-demo), so systemd is left alone except for the
# shared nvim server that nvc attaches to (ignored entries survive exact_user).
# Products/platform (.chezmoiexternal.toml) still applies: the clearhead skill
# links point into it, and chezmoi never touches an existing checkout.
*
!.bashrc
!.gitconfig
!.markdownlint-cli2.yaml
!.claude
!.pi
# pi rewrites this file (deviceId, changelog); a plain copy would fight it and add packages.
.pi/agent/settings.json
!.gemini
!.config
.config/*
!.config/clearhead
!.config/nvim
!.config/systemd
.config/systemd/*
!.config/systemd/user
.config/systemd/user/*
!.config/systemd/user/neovim-server.service
!.local
.local/*
!.local/bin
.local/bin/*
!.local/bin/chezmoi-diff
!.local/bin/chezmoi-pager
!.local/bin/copilot-language-server
!.local/bin/clj-kondo
!.local/bin/cljfmt
!.local/bin/clojure-lsp
!.local/bin/cwork
!.local/bin/java
!.local/bin/nv
!.local/bin/nvc
!.local/bin/nrepl-*
!.local/bin/say
!.local/bin/okf
!.local/bin/op
!.local/bin/stripe
!.local/bin/tree-sitter
!.local/bin/worktree_*
!.local/lib
.local/lib/*
!.local/lib/jdk
{{ end }}

