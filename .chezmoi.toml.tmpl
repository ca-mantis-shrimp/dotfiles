{{- /* desktop (default) or agent-host: a headless agent machine on an immutable image. */ -}}
{{- $role := promptStringOnce . "role" "Machine role (desktop or agent-host)" "desktop" }}
[data]
role = {{ $role | quote }}

{{ if eq .chezmoi.os "windows" }}
[cd]
command = "pwsh"
{{ end }}

[diff]
command = "{{ .chezmoi.homeDir }}/.local/bin/chezmoi-diff"
args = ["{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]
pager = "{{ .chezmoi.homeDir }}/.local/bin/chezmoi-pager"

[merge]
command = "nvim"
args = ["-d", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

[edit]
command = "nvim"

[git]
autoCommit = true

[onepassword]
mode = "service"

{{ if and (eq .chezmoi.os "linux") (ne (env "CHEZMOI_CONTAINER") "1") (ne $role "agent-host") }}
[hooks.read-source-state.pre]
    command = "sh"
    args = ["{{ .chezmoi.sourceDir }}/bootstrap-paru.sh"]
{{ end }}
