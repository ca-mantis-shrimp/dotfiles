{{ if eq .chezmoi.os "windows" }}
[cd]
command = "pwsh"
{{ end }}

[diff]
command = "{{ .chezmoi.homeDir }}/.local/bin/chezmoi-diff"
args = ["{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

[merge]
command = "nvim"
args = ["-d", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

[edit]
command = "nvim"

[git]
autoCommit = true

[onepassword]
mode = "service"

{{ if eq .chezmoi.os "linux" }}
{{ if and (eq .chezmoi.osRelease.id "arch") (not (contains "particleos" (default "" .chezmoi.osRelease.idLike))) (ne (env "CHEZMOI_CONTAINER") "1") (ne (env "CHEZMOI_IMMUTABLE") "1") }}
[hooks.read-source-state.pre]
    command = "sh"
    args = ["{{ .chezmoi.sourceDir }}/bootstrap-paru.sh"]
{{ end }}
{{ end }}
