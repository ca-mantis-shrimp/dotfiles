{{ if eq .chezmoi.os "windows" }}
[cd]
command = "pwsh"
{{ end }}

[diff]
command = "{{ .chezmoi.homeDir }}/.local/bin/chezmoi-diff"
args = ["{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

[merge]
command = "nvim"
args = ["-d", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

[edit]
command = "nvim"

[git]
autoCommit = true

[onepassword]
mode = "service"

{{ if and (eq .chezmoi.os "linux") (ne (env "CHEZMOI_CONTAINER") "1") }}
[hooks.read-source-state.pre]
    command = "sh"
    args = ["{{ .chezmoi.sourceDir }}/bootstrap-paru.sh"]
{{ end }}
