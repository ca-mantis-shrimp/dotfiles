#!/bin/bash

export PATH="$HOME/.local/bin:$PATH"

{{ if eq (index . "role" | default "desktop") "agent-host" -}}
# The user manager reads environment.d; bash logins don't, so read it here too.
for f in "$HOME"/.config/environment.d/*.conf; do
    [ -r "$f" ] && { set -a; . "$f"; set +a; }
done

{{ end -}}
if [ -n "${CREDENTIALS_DIRECTORY:-}" ] && [ -f "$CREDENTIALS_DIRECTORY/GH_TOKEN" ]; then
export GH_TOKEN="$(<"$CREDENTIALS_DIRECTORY/GH_TOKEN")"
fi

# Set up fzf key bindings and fuzzy completion
command -v fzf >/dev/null && eval "$(fzf --bash)"
# properly setup environment variables for lua
command -v luarocks >/dev/null && eval $(luarocks path --bin)

command -v starship >/dev/null && eval "$(starship init bash)"

# Agent shells: a pipeline fails when any stage fails, so
# `cmd | tail` cannot report cmd's failure as success.
[ -n "${CLAUDECODE-}" ] && set -o pipefail
