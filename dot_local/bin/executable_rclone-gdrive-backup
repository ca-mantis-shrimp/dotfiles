#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rclone/gdrive-backup.env"

if [[ ! -f "$ENV_FILE" ]]; then
    printf 'Missing env file: %s\n' "$ENV_FILE" >&2
    exit 1
fi

# shellcheck disable=SC1090
source "$ENV_FILE"

for required in SRC_DIR DEST_REMOTE; do
    if [[ -z "${!required:-}" ]]; then
        printf 'Missing required setting in env file: %s\n' "$required" >&2
        exit 1
    fi
done

LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/rclone-gdrive-backup.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    printf 'rclone-gdrive-backup: another run is already active\n' >&2
    exit 0
fi

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rclone"
mkdir -p "$LOG_DIR"

args=(
    sync
    "$SRC_DIR"
    "$DEST_REMOTE"
    --fast-list
    --transfers "${RCLONE_TRANSFERS:-4}"
    --checkers "${RCLONE_CHECKERS:-8}"
    --retries "${RCLONE_RETRIES:-5}"
    --low-level-retries "${RCLONE_LOW_LEVEL_RETRIES:-10}"
    --timeout "${RCLONE_TIMEOUT:-1m}"
    --log-level "${RCLONE_LOG_LEVEL:-INFO}"
    --log-file "$LOG_DIR/gdrive-backup.log"
)

if [[ -n "${RCLONE_EXCLUDE_FROM:-}" ]]; then
    args+=(--exclude-from "$RCLONE_EXCLUDE_FROM")
fi

exec rclone "${args[@]}"
