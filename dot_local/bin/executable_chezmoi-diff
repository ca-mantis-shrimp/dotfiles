#!/bin/sh
# chezmoi diff.command: nvim -d for a human at a terminal, plain unified diff
# otherwise so scripts and agents don't hang on an editor.
if [ -t 0 ] && [ -t 1 ]; then
	exec nvim -d "$1" "$2"
fi
diff -u "$1" "$2"
# diff exits 1 when files differ; chezmoi would treat that as an error.
exit 0
