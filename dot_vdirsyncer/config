[general]
status_path = "~/.vdirsyncer/status/"

[pair plans]
a = "plans_local"
b = "plans_radicale"
collections = ["from a", "from b"]
conflict_resolution = "a wins"

[storage plans_local]
type = "filesystem"
path = "~/.local/share/clearhead/plans/"
fileext = ".ics"

[storage plans_radicale]
type = "caldav"
url = "http://localhost:5232/backup-admin/"
username = "backup-admin"
password.fetch = ["command", "pass", "radicale/password"]
