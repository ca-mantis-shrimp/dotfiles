[general]
status_path = "~/.vdirsyncer/status/"

[pair plans]
a = "plans_local"
b = "plans_google"
collections = [["reflections", "reflections", "cab23d388fd8b8436abc482ef5b5cdcbfa104bbe23e6fb8d4700cee307f5727e@group.calendar.google.com"]]
conflict_resolution = "a wins"

[storage plans_local]
type = "filesystem"
path = "~/.local/share/clearhead/plans/"
fileext = ".ics"

[storage plans_google]
type = "google_calendar"
token_file = "~/.vdirsyncer/google_token"
client_id.fetch = ["command", "pass", "vdirsyncer/google/client-id"]
client_secret.fetch = ["command", "pass", "vdirsyncer/google/client-secret"]
