[general]
status_path = "~/.vdirsyncer/status/"

[pair reflections]
a = "reflections_local"
b = "reflections_google"
collections = ["reflections"]
conflict_resolution = "a wins"

[storage reflections_local]
type = "filesystem"
path = "~/.local/share/clearhead/charters/reflections.plans/"
fileext = ".ics"

[storage reflections_google]
type = "google_calendar"
token_file = "~/.vdirsyncer/google_token"
client_id.fetch = ["command", "pass", "vdirsyncer/google/client-id"]
client_secret.fetch = ["command", "pass", "vdirsyncer/google/client-secret"]

[storage local]
type = "singlefile"
path = "~/.contacts/%s.vcf"

[storage online]
type = "carddav"
url = "CARDDAV_LINK"
username = "USERNAME"
password = "PASSWORD"
read_only = true

[pair contacts]
a = "local"
b = "online"
collections = ["from a", "from b"]
conflict_resolution = "b wins"
