set -xg WWW_HOME "http://www.duckduckgo.com"
set -xg EDITOR "nvim"
set -xg PAGER "nvim +Man!"

set -xg npm_config_prefix "$HOME/.local"

# Agent telemetry → tailnet-only OTLP hub. Claude Code is configured in
# ~/.claude/settings.json instead, so it exports however it is launched.
set -xg OTEL_RESOURCE_ATTRIBUTES "host.name=$hostname"
set -xg OTEL_EXPORTER_OTLP_PROTOCOL http/protobuf
# opencode and Gemini append /v1/<signal> to this base URL.
set -xg OTEL_EXPORTER_OTLP_ENDPOINT "{{ .telemetry.otlpHub }}"
# Pi (pi-otlp) uses this verbatim and ignores the base URL's path convention.
set -xg PI_OTLP_ENABLE 1
set -xg OTEL_METRICS_EXPORTER otlp
set -xg OTEL_EXPORTER_OTLP_METRICS_ENDPOINT "{{ .telemetry.otlpHub }}/v1/metrics"
# Gemini defaults to gRPC and to logging prompts; keep content out.
set -xg GEMINI_TELEMETRY_ENABLED true
set -xg GEMINI_TELEMETRY_OTLP_PROTOCOL http
set -xg GEMINI_TELEMETRY_LOG_PROMPTS false

fish_add_path "$HOME/.cargo/bin"
fish_add_path "$HOME/.local/bin"
# The agent sandbox runs from its checkout; skipped where there is none.
fish_add_path "$HOME/Products/agent-sandbox/bin"
# Where its sessions' images live on this host: the base tree (personal-os's
# sandbox-worker build, until it is published) and the layer images.
set -gx AGENT_BASE "$HOME/Products/personal-os/mkosi.output/sandbox-worker/PersonalOS__x86-64"
set -gx AGENT_LAYERS "$HOME/.cache/agent-layers"


{{ if eq .chezmoi.os "android" }}
set -xg TMPDIR "/data/data/com.termux/files/usr/tmp"
{{ end }}

{{ if eq .chezmoi.os "linux" }}
{{ if (contains "Microsoft" (default "" (index .chezmoi.kernel "osrelease"))) }}
alias op="op.exe"
{{ end }}
{{ end }}

fish_vi_key_bindings
function SpawnNeovideWindow
 systemctl --user start neovide-client
end

starship init fish | source

# Only run nerdfetch if we're in an interactive terminal
if status is-interactive && isatty stdout
    nerdfetch
end
