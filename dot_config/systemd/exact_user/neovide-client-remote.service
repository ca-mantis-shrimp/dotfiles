[Unit]
Description=Neovide GUI Instance (Remote via Tailscale)
Documentation=https://neovide.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/neovide --server mini-travel-server.tail1cbf8a.ts.net:6666
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
