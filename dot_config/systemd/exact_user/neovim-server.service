[Unit]
Description=Neovim Embedded Server (Backend)
Documentation=man:nvim

[Service]
Type=exec
RuntimeDirectory=nvim
# A unix socket only: nvim's RPC has no auth, so remote clients forward it over ssh.
ExecStart=/usr/bin/nvim --headless --listen %t/nvim/server.sock
Restart=on-success

[Install]
WantedBy=default.target
